# Arquivo de configuração de ambiente
# Renomeie para .env e configure as variáveis conforme necessário

# Configurações do Banco de Dados
DB_NAME=bergamoto.db

# Configurações da UI
UI_THEME=equilux
UI_FULLSCREEN=true
UI_FONT_SIZE=16

# Configurações da Câmera
CAMERA_DEVICE=0
CAMERA_AUTO_PHOTO_DELAY=3000

# Configurações de Logging
LOG_LEVEL=INFO

# Bot Telegram (se usar)
# TELEGRAM_BOT_TOKEN=your_token_here

# Configurações específicas do ambiente
# CUSTOM_DATA_DIR=/path/to/custom/data/directory